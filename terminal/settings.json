{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [],
    "centerOnLaunch": true,
    "copyOnSelect": true,
    "defaultProfile": "{1a3de92d-2bd4-4531-bd06-0156d92411f9}",
    "disableAnimations": true,
    "keybindings":
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+shift+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+shift+v"
        },
        {
            "id": "Terminal.DuplicateTab",
            "keys": "alt+shift+d"
        },
        {
            "id": "Terminal.SplitPaneDown",
            "keys": "ctrl+minus"
        },
        {
            "id": "Terminal.SplitPaneRight",
            "keys": "ctrl+\\"
        },
        {
            "id": null,
            "keys": "alt+right"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": null,
            "keys": "alt+left"
        },
        {
            "id": null,
            "keys": "alt+up"
        },
        {
            "id": null,
            "keys": "alt+down"
        }
    ],
    "launchMode": "maximized",
    "newTabMenu":
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles":
    {
        "defaults":
        {
            "bellStyle": "none",
            "colorScheme": "Dark+",
            "cursorShape": "filledBox",
            "font":
            {
                "face": "MesloLGL Nerd Font Mono",
                "size": 10,
                "weight": "normal"
            },
            "historySize": 100000,
            "opacity": 95,
            "padding": "0",
            "scrollbarState": "hidden",
            "startingDirectory": ".",
            "suppressApplicationTitle": true,
            "tabTitle": null,
            "useAcrylic": false
        },
        "list":
        [
            {
                "commandline": "C:\\Program Files\\PowerShell\\7\\pwsh.exe -nologo",
                "cursorColor": "#E5E5E5",
                "guid": "{1a3de92d-2bd4-4531-bd06-0156d92411f9}",
                "icon": "ms-appx:///ProfileIcons/pwsh.png",
                "name": "PS7",
                "tabTitle": "PS7"
            },
            {
                "commandline": "C:\\Program Files\\PowerShell\\7\\pwsh.exe -nologo",
                "elevate": true,
                "guid": "{1a3de92d-2bd4-4531-bd06-0156d92422f9}",
                "icon": "ms-appx:///ProfileIcons/pwsh.png",
                "name": "PS7 (Admin)",
                "tabTitle": "PS7 (Admin)"
            }
        ]
    },
    "schemes": [],
    "showTerminalTitleInTitlebar": false,
    "tabSwitcherMode": "inOrder",
    "themes": [],
    "useAcrylicInTabRow": true,
    "windowingBehavior": "useAnyExisting"
}