set clipboard=unnamed,unnamedplus
set cursorline
set ignorecase
set incsearch
set relativenumber
set scrolloff=8
set smartcase

" =============================================================================
" Clipboard-safe deletes
" =============================================================================
nnoremap <silent> x     "_x
nnoremap <silent> X     "_X
nnoremap <silent> <Del> "_x
xnoremap <silent> p "_dP

" =============================================================================
" Editing ergonomics
" =============================================================================
" better indenting
vnoremap <silent> < <gv
vnoremap <silent> > >gv

" keep cursor centered when paging
nnoremap <silent> <C-d> <C-d>zz
nnoremap <silent> <C-u> <C-u>zz

" yank to end of line
nnoremap <silent> Y y$

" join without moving cursor
nnoremap <silent> J mzJ`z

" next search result keeps cursor centered + opens folds
nnoremap <silent> n nzzzv
nnoremap <silent> N Nzzzv

" break undo sequence at punctuation
inoremap <silent> , ,<C-g>u
inoremap <silent> . .<C-g>u

" clear highlights
nnoremap <silent> <C-l> :nohl<CR>

" =============================================================================
" Navigation / VS tooling (mappings)
" =============================================================================
" tab navigation (like VS Code editor tabs)
nnoremap <silent> ]b gt
nnoremap <silent> [b gT

" paste line above/below while preserving cursor
nnoremap <silent> ]p m`o<ESC>p``
nnoremap <silent> [p m`O<ESC>p``

" insert blank line above/below (no insert mode)
nnoremap <silent> ]<Space> m`o<Esc>``
nnoremap <silent> [<Space> m`O<Esc>``

" diff navigation
nnoremap <silent> ]c      :vsc Diff.NextDifference<CR>
nnoremap <silent> [c      :vsc Diff.PreviousDifference<CR>
nnoremap <silent> <A-Down> :vsc Diff.NextDifference<CR>
nnoremap <silent> <A-Up>   :vsc Diff.PreviousDifference<CR>

" diagnostics / issues
nnoremap <silent> ]d :vsc Edit.GoToNextIssueInFile<CR>
nnoremap <silent> [d :vsc Edit.GoToPreviousIssueInFile<CR>

" error navigation
nnoremap <silent> ]e :vsc View.NextError<CR>
nnoremap <silent> [e :vsc View.PreviousError<CR>
nnoremap <silent> ]E :vsc View.NextError<CR>
nnoremap <silent> [E :vsc View.PreviousError<CR>

" method navigation
nnoremap <silent> ]m :vsc Edit.NextMethod<CR>
nnoremap <silent> [m :vsc Edit.PreviousMethod<CR>

" spelling
nnoremap <silent> ]s :vsc Tools.MovetoNextSpellingIssue<CR>
nnoremap <silent> [s :vsc Tools.MovetoPriorSpellingIssue<CR>

" move lines (add visual-mode support + make silent)
nnoremap <silent> <A-j> :vsc Edit.MoveSelectedLinesDown<CR>
nnoremap <silent> <A-k> :vsc Edit.MoveSelectedLinesUp<CR>
vnoremap <silent> <A-j> :vsc Edit.MoveSelectedLinesDown<CR>
vnoremap <silent> <A-k> :vsc Edit.MoveSelectedLinesUp<CR>

" commenting (make silent + keep both normal/visual)
nnoremap <silent> gcc :vsc Edit.ToggleLineComment<CR>
vnoremap <silent> gcc :vsc Edit.ToggleLineComment<CR>
nnoremap <silent> gc  :vsc Edit.ToggleBlockComment<CR>
vnoremap <silent> gc  :vsc Edit.ToggleBlockComment<CR>

" code navigation
nnoremap <silent> g; :vsc Edit.GoToLastEditLocation<CR>
nnoremap <silent> gb :vsc Edit.GoToBase<CR>
nnoremap <silent> gd :vsc Edit.GoToDefinition<CR>
nnoremap <silent> gI :vsc Edit.GoToImplementation<CR>
nnoremap <silent> gp :vsc Edit.PeekDefinition<CR>
nnoremap <silent> gr :vsc Edit.FindAllReferences<CR>

" VS navigation
nnoremap <silent> <C-o> :vsc View.NavigateBackward<CR>
nnoremap <silent> <C-i> :vsc View.NavigateForward<CR>

" keep Ctrl-n/p for VS line down/up
nnoremap <silent> <C-n> :vsc Edit.LineDown<CR>
nnoremap <silent> <C-p> :vsc Edit.LineUp<CR>
nnoremap <silent> <C-r> :vsc Edit.Redo<CR>

" command palette/symbol
nnoremap <silent> <C-S-t> :vsc Edit.GoToSymbol<CR>
nnoremap <silent> <C-S-p> :vsc Window.QuickLaunch<CR>

" quick code actions
nnoremap <silent> <A-Enter> :vsc Edit.QuickActions<CR>

" quick info
nnoremap <silent> <S-k> :vsc Edit.QuickInfo<CR>

" window management
nnoremap <silent> <C-w>q :vsc Window.CloseDocumentWindow<CR>
nnoremap <silent> <C-w>o :vsc File.CloseOtherTabs<CR>
nnoremap <silent> <C-w>v :vsc Window.NewVerticalTabGroup<CR>
nnoremap <silent> <C-w>s :vsc Window.NewHorizontalTabGroup<CR>

" =============================================================================
" Leader mappings
" =============================================================================
let mapleader=" "

" Explorer
nnoremap <silent> <leader>e  :vsc View.SolutionExplorer<CR>
nnoremap <silent> <leader>v  :vsc View.ViewCode<CR>

" reveal current file in Solution Explorer
nnoremap <silent> <leader>E  :vsc View.TrackActivityInSolutionExplorer<CR>

" Copilot
nnoremap <silent> <leader>c  :vsc View.GitHub.Copilot.Chat<CR>
nnoremap <silent> <leader>i  :vsc Copilot.Open<CR>

" Formatting
nnoremap <silent> <leader>cf :vsc Edit.FormatDocument<CR>

" Files
nnoremap <silent> <leader>ff :vsc File.OpenFile<CR>
nnoremap <silent> <leader>fr :vsc File.NavigateToRecentFile<CR>
nnoremap <silent> <leader>of :vsc File.OpenContainingFolder<CR>
nnoremap <silent> <leader>oF :vsc File.OpenFolder<CR>

" Save
nnoremap <silent> <leader>w  :vsc File.SaveSelectedItems<CR>
nnoremap <silent> <leader>W  :vsc File.SaveAll<CR>

" Search
nnoremap <silent> <leader>sw :vsc Edit.Find<CR>
nnoremap <silent> <leader>sW :vsc Edit.FindInFiles<CR>
nnoremap <silent> <leader>ss :vsc Edit.GoToSymbol<CR>
nnoremap <silent> <leader>sS :vsc Edit.GoToAll<CR>

" Refactor
nnoremap <silent> <leader>rn :vsc Refactor.Rename<CR>

" Quick actions
nnoremap <silent> <leader>ca :vsc Edit.QuickActions<CR>

" Git
nnoremap <silent> <leader>fp :vsc View.Repository<CR>
nnoremap <silent> <leader>gg :vsc View.GitWindow<CR>
nnoremap <silent> <leader>gr :vsc View.GitRepositoryWindow<CR>
nnoremap <silent> <leader>gs :vsc View.GitChanges<CR>

" Tools
nnoremap <silent> <leader>x  :vsc ManageExtensions<CR>

" Team/Test
nnoremap <silent> <leader>te :vsc View.Tfs.TeamExplorer<CR>
nnoremap <silent> <leader>tt :vsc TestExplorer.ShowTestExplorer<CR>